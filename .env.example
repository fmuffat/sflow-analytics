# Copy to .env and adjust. Never commit .env.

APP_NAME="sFlow Analytics"
APP_TIMEZONE=Europe/Paris
APP_VERSION=dev

# --- Collector ---
SFLOW_LISTEN_ADDRESS=0.0.0.0
SFLOW_PORT=6343
# Decode workers (default: number of CPUs)
#SFLOW_WORKERS=4
# Datagrams buffered between the UDP socket and the decoders
SFLOW_QUEUE_SIZE=8192
# Kernel UDP receive buffer (bytes)
SFLOW_READ_BUFFER_BYTES=8388608
# Exporter is marked inactive after this silence
EXPORTER_INACTIVE_TIMEOUT=5m
# Collector status HTTP endpoint (inside the container)
COLLECTOR_HTTP_ADDRESS=:8081
# Published on the host at 127.0.0.1:<port> in development
COLLECTOR_HTTP_PORT=8081
# Summary log line interval (0 = disabled)
COLLECTOR_STATS_LOG_INTERVAL=1m

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json
# Also write decoded flows to the log (rate-limited); useful for debugging
SFLOW_LOG_FLOWS=false
SFLOW_LOG_FLOWS_PER_SECOND=20

# --- ClickHouse ---
CLICKHOUSE_ENABLED=true
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=sflow
CLICKHOUSE_USER=sflow
# scripts/dev-up.sh replaces this with a random password on first run
CLICKHOUSE_PASSWORD=change-me
# Rows per INSERT, and max wait before a partial batch is sent
CLICKHOUSE_BATCH_SIZE=5000
CLICKHOUSE_FLUSH_INTERVAL=1s
# Buffers: rows queued for the writer / rows kept for retry while ClickHouse is down
CLICKHOUSE_QUEUE_ROWS=200000
CLICKHOUSE_MAX_PENDING_ROWS=500000

# --- Retention and disk protection ---
# Flow records and interface counters older than this are deleted (1-3650).
# Hourly interface history (Trends) is kept 3 years regardless.
# Sizing: docs/architecture.md "Storage sizing"
RETENTION_DAYS=90
# Above this disk usage the oldest days are dropped early; inserts are
# suspended at +10 points (max 98 %)
DISK_MAX_USAGE_PERCENT=85
# How often the exporter inventory is saved
INVENTORY_SAVE_INTERVAL=30s

# --- API ---
# Published on the host at 127.0.0.1:<port> in development (nginx in Phase 4)
API_PORT=8000

# --- Web (nginx) ---
# Put in the self-signed certificate generated on first start. Example:
# TLS_COMMON_NAME=sflow.example.local and TLS_EXTRA_SAN=IP:192.0.2.10
TLS_COMMON_NAME=sflow-analytics
TLS_EXTRA_SAN=

# --- Authentication (API) ---
# Never disable authentication outside local development.
AUTH_ENABLED=true
ADMIN_USERNAME=admin
# Initial admin password. Empty: a random one is generated at first start, printed
# in the API log and written to initial-admin-password on the app-config volume.
ADMIN_PASSWORD=
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# Key encrypting stored secrets (controller credentials). Empty: generated in the
# app-config volume. To set it yourself: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
